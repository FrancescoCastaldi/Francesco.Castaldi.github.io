{
  "name": "Slate Grey Minimalist",
  "colors": {
    "space-void": {
      "hex": "#0F172A",
      "role": "Deepest background (app root)"
    },
    "space-surface": {
      "hex": "#1E293B",
      "role": "Elevated background (cards, sections)"
    },
    "space-elevated": {
      "hex": "#334155",
      "role": "Hover states for cards, raised elements"
    },
    "accent-primary": {
      "hex": "#CBD5E1",
      "role": "Main accent color (replacing blue/gold) for important highlights, badges, primary CTA"
    },
    "accent-secondary": {
      "hex": "#94A3B8",
      "role": "Secondary accent for subtle outlines, secondary links, and icons"
    },
    "text-primary": {
      "hex": "#F8FAFC",
      "role": "Headings, primary text"
    },
    "text-body": {
      "hex": "#94A3B8",
      "role": "Paragraphs, standard reading text"
    },
    "text-muted": {
      "hex": "#64748B",
      "role": "Meta text, breadcrumbs, footers"
    }
  }
}
